; PHAGOS — native Godot engine for the skin cross-section study.
; Browser UI/UX is owned by the separate HTML/JS web application under web/.
config_version=5

[application]
config/name="PHAGOS | Skin Cross-Section Study"
config/description="A clean native Godot study of layered skin, fat, muscle, fascia, and an open cavity."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display/window]
size/viewport_width=1920
size/viewport_height=1080
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"
stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.04, 0.10, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
